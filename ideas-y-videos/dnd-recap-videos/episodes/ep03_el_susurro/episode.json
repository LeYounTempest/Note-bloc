    {
     "t0": 0,
     "t1": 0.67,
     "text": "¡Fuego!",
     "big": false
    },
    {
     "t0": 0.69,
     "t1": 1.54,
     "text": "¡Escudos!",
     "big": false
    },
    {
     "t0": 1.56,
     "t1": 2.9,
     "text": "¡Hielo contra escamas!",
     "big": false
    },
    {
     "t0": 2.92,
     "t1": 4.26,
     "text": "El kenku resistía.",
     "big": false
    },
    {
     "t0": 4.28,
     "t1": 5.93,
     "text": "El bardo volvió a atacar.",
     "big": false
    },
    {
     "t0": 5.95,
     "t1": 6.81,
     "text": "Y el elfo...",
     "big": false
    },
    {
     "t0": 6.83,
     "t1": 8.41,
     "text": "se hizo invisible.",
     "big": false
    },
    {
     "t0": 8.43,
     "t1": 9.6,
     "text": "Qué conveniente.",
     "big": false
    },
    {
     "t0": 9.62,
     "t1": 11.36,
     "text": "El dracónido cayó herido.",
     "big": false
    },
    {
     "t0": 11.38,
     "t1": 13.03,
     "text": "Uno de nosotros corrió.",
     "big": false
    },
    {
     "t0": 13.05,
     "t1": 15.19,
     "text": "Nuestro hermano lo levantó...",
     "big": false
    },
    {
     "t0": 15.21,
     "t1": 18.14,
     "text": "aunque a tres de los nuestros mató.",
     "big": false
    },
    {
     "t0": 18.16,
     "t1": 21.25,
     "text": "Aun así quiso salvarlo.",
     "big": false
    },
    {
     "t0": 21.27,
     "t1": 25.77,
     "text": "Porque era mejor que él.",
     "big": false
    }
