   ],
   "lines": [
    {
     "t0": 0,
     "t1": 3.25,
     "text": "Entonces escuchó un susurro",
     "big": false
    },
    {
     "t0": 3.27,
     "t1": 6.52,
     "text": "que ninguno pudo ver.",
     "big": false
    },
    {
     "t0": 6.54,
     "t1": 9.31,
     "text": "Sus ojos se abrieron.",
     "big": false
    },
    {
     "t0": 9.33,
     "t1": 12.02,
     "text": "Su corazón se detuvo.",
     "big": false
    },
    {
     "t0": 12.04,
     "t1": 14.5,
     "text": "Y nuestro hermano...",
     "big": false
    },
    {
     "t0": 14.52,
     "t1": 16.33,
     "text": "cayó.",
     "big": false
    },
    {
     "t0": 16.35,
     "t1": 17.37,
     "text": "Cuatro...",
     "big": false
    },
    {
     "t0": 17.39,
     "t1": 20.0,
     "text": "Pero todavía faltaba algo peor.",
     "big": false
    },
    {
     "t0": 20.02,
     "t1": 22.0,
     "text": "El bardo tomó su cuerpo.",
     "big": false
    },
    {
     "t0": 22.02,
     "t1": 25.75,
     "text": "Al kobold que acababa de salvarlo...",
     "big": false
    },
    {
     "t0": 25.77,
     "t1": 28.7,
     "text": "contra el dragón lo arrojó.",
     "big": false
    },
    {
     "t0": 28.72,
     "t1": 31.49,
     "text": "Y nuestro hermano explotó.",
     "big": false
    },
    {
     "t0": 31.51,
     "t1": 32.53,
     "text": "Él te salvó...",
     "big": false
    },
    {
     "t0": 32.55,
     "t1": 33.64,
     "text": "Él te ayudó...",
     "big": false
    },
    {
     "t0": 33.66,
     "t1": 35.08,
     "text": "Después de todo...",
     "big": false
    },
    {
     "t0": 35.1,
     "t1": 37.48,
     "text": "te ayudó...",
     "big": false
    },
    {
     "t0": 37.5,
     "t1": 39.31,
     "text": "Y convertiste su cuerpo",
     "big": false
    },
    {
     "t0": 39.33,
     "t1": 43.83,
     "text": "en un arma.",
     "big": false
    },
    {
     "t0": 43.88,
     "t1": 47.45,
     "text": "Miramos a nuestro jefe.",
     "big": false
    },
    {
     "t0": 47.47,
     "t1": 49.36,
     "text": "Algo dentro de él...",
     "big": false
    },
    {
     "t0": 49.38,
     "t1": 53.88,
     "text": "se rompió.",
     "big": false
    }
   ],
