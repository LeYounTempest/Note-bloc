   "lines": [
    {
     "t0": 0.01,
     "t1": 4.51,
     "text": "Mr. Iguana levantó una mano.",
     "big": false
    },
    {
     "t0": 5.04,
     "t1": 8.05,
     "text": "El océano dejó de avanzar.",
     "big": false
    },
    {
     "t0": 8.07,
     "t1": 10.52,
     "text": "La escarcha cubrió la costa.",
     "big": false
    },
    {
     "t0": 10.54,
     "t1": 13.55,
     "text": "El aire comenzó a cristalizar.",
     "big": false
    },
    {
     "t0": 13.57,
     "t1": 15.95,
     "text": "Las llamas murieron.",
     "big": false
    },
    {
     "t0": 15.97,
     "t1": 19.38,
     "text": "El cobre dejó de brillar.",
     "big": false
    },
    {
     "t0": 19.4,
     "t1": 23.13,
     "text": "Y por primera vez aquel dragón...",
     "big": false
    },
    {
     "t0": 23.15,
     "t1": 27.65,
     "text": "intentó escapar.",
     "big": false
    },
    {
     "t0": 28.89,
     "t1": 30.71,
     "text": "¡DEMASIADO TARDE!",
     "big": true
    },
    {
     "t0": 30.73,
     "t1": 32.23,
     "text": "¡QUE CALLE EL CIELO!",
     "big": true
    },
    {
     "t0": 32.25,
     "t1": 33.34,
     "text": "¡QUE SE CONGELE EL MAR!",
     "big": true
    },
    {
     "t0": 33.36,
     "t1": 35.1,
     "text": "¡POR NUESTROS CUATRO HERMANOS",
     "big": true
    },
    {
     "t0": 35.12,
     "t1": 37.01,
     "text": "QUE NO VOLVERÁN!",
     "big": true
    },
    {
     "t0": 37.03,
     "t1": 41.53,
     "text": "¡RAYO DE HIELO!",
     "big": true
    },
    {
     "t0": 42.14,
     "t1": 45.15,
     "text": "El rayo atravesó sus escamas.",
     "big": false
    },
    {
     "t0": 45.17,
     "t1": 48.1,
     "text": "Su cuerpo empezó a cristalizar.",
     "big": false
    },
    {
     "t0": 48.12,
     "t1": 50.73,
     "text": "El dragón quedó congelado...",
     "big": false
    },
    {
     "t0": 50.75,
     "t1": 54.17,
     "text": "sin poder siquiera gritar.",
     "big": false
    },
    {
     "t0": 54.19,
     "t1": 55.2,
     "text": "Una grieta.",
     "big": false
    },
    {
     "t0": 55.22,
     "t1": 56.64,
     "text": "Luego otra.",
     "big": false
    },
    {
     "t0": 56.66,
     "t1": 58.55,
     "text": "Y otra más...",
     "big": false
    },
    {
     "t0": 58.57,
     "t1": 60.95,
     "text": "¡Y SE HIZO PEDAZOS",
     "big": false
    },
    {
     "t0": 60.97,
     "t1": 65.47,
     "text": "SOBRE EL MAAAAAR!",
     "big": true
    }
   ],
