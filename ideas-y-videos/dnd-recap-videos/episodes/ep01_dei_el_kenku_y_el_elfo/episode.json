   "lines": [
    {
     "t0": -0.02,
     "t1": 1.64,
     "text": "¡Jefe! ¡Hay ladrones",
     "big": false
    },
    {
     "t0": 1.66,
     "t1": 3.24,
     "text": "cerca del barco, por allá!",
     "big": false
    },
    {
     "t0": 3.26,
     "t1": 4.83,
     "text": "Un elfo apareció con vino,",
     "big": false
    },
    {
     "t0": 4.85,
     "t1": 6.27,
     "text": "como queriendo conversar.",
     "big": false
    },
    {
     "t0": 6.29,
     "t1": 7.86,
     "text": "Tres hermanos fueron hacia el bardo,",
     "big": false
    },
    {
     "t0": 7.88,
     "t1": 9.54,
     "text": "solo lo querían amarrar.",
     "big": false
    },
    {
     "t0": 9.56,
     "t1": 12.89,
     "text": "Pero vimos un relámpago...",
     "big": false
    },
    {
     "t0": 12.91,
     "t1": 13.69,
     "text": "¡UNO!",
     "big": true
    },
    {
     "t0": 13.71,
     "t1": 14.41,
     "text": "¡DOS!",
     "big": true
    },
    {
     "t0": 14.43,
     "t1": 15.2,
     "text": "¡TRES!",
     "big": true
    },
    {
     "t0": 15.22,
     "t1": 18.88,
     "text": "Tres cuerpos cayeron frente al mar.",
     "big": false
    },
    {
     "t0": 18.9,
     "t1": 22.46,
     "text": "Mr. Iguana alzó sus manos.",
     "big": false
    },
    {
     "t0": 22.48,
     "t1": 24.14,
     "text": "¡VENTISCA!",
     "big": true
    },
    {
     "t0": 24.16,
     "t1": 27.01,
     "text": "El viento comenzó a gritar.",
     "big": false
    },
    {
     "t0": 27.03,
     "t1": 29.65,
     "text": "El dracónido salió volando,",
     "big": false
    },
    {
     "t0": 29.67,
     "t1": 34.17,
     "text": "separado de los demás.",
     "big": false
    },
    {
     "t0": 36.69,
     "t1": 39.86,
     "text": "Éramos siete en esta costa.",
     "big": false
    },
    {
     "t0": 39.88,
     "t1": 42.81,
     "text": "Ahora tres no volverán.",
     "big": false
    },
    {
     "t0": 42.83,
     "t1": 44.89,
     "text": "No buscábamos una guerra.",
     "big": false
    },
    {
     "t0": 44.91,
     "t1": 47.92,
     "text": "Solo queríamos saquear.",
     "big": false
    },
    {
     "t0": 47.94,
     "t1": 51.03,
     "text": "Tres lugares junto al fuego...",
     "big": false
    },
    {
     "t0": 51.05,
     "t1": 55.55,
     "text": "nadie los volverá a ocupar.",
     "big": false
    }
   ],
