    {
     "t0": 0,
     "t1": 3.46,
     "text": "Entonces el océano rugió.",
     "big": false
    },
    {
     "t0": 3.48,
     "t1": 6.49,
     "text": "Cobre emergió desde el mar.",
     "big": false
    },
    {
     "t0": 6.51,
     "t1": 9.84,
     "text": "Un dragón adulto abrió sus alas...",
     "big": false
    },
    {
     "t0": 9.86,
     "t1": 14.36,
     "text": "y tuvimos que dejar de luchar.",
     "big": false
    },
    {
     "t0": 14.97,
     "t1": 15.67,
     "text": "¡Fuego!",
     "big": false
    },
    {
     "t0": 15.69,
     "t1": 16.54,
     "text": "¡Escudos!",
     "big": false
    },
    {
     "t0": 16.56,
     "t1": 17.9,
     "text": "¡Hielo contra escamas!",
     "big": false
    },
    {
     "t0": 17.92,
     "t1": 19.26,
     "text": "El kenku resistía.",
     "big": false
    },
    {
     "t0": 19.28,
     "t1": 20.93,
     "text": "El bardo volvió a atacar.",
     "big": false
    },
    {
     "t0": 20.95,
     "t1": 21.81,
     "text": "Y el elfo...",
     "big": false
    },
    {
     "t0": 21.83,
     "t1": 23.41,
     "text": "se hizo invisible.",
     "big": false
    },
    {
     "t0": 23.43,
     "t1": 24.6,
     "text": "Qué conveniente.",
     "big": false
    }
