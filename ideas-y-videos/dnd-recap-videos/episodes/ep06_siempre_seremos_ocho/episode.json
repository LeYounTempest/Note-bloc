   "lines": [
    {
     "t0": 0,
     "t1": 0.99,
     "text": "Después...",
     "big": false
    },
    {
     "t0": 1.01,
     "t1": 3.7,
     "text": "solo quedaron las olas.",
     "big": false
    },
    {
     "t0": 3.72,
     "t1": 6.34,
     "text": "Nuestro jefe nos comenzó a contar.",
     "big": false
    },
    {
     "t0": 6.36,
     "t1": 7.13,
     "text": "Uno.",
     "big": false
    },
    {
     "t0": 7.15,
     "t1": 7.85,
     "text": "Dos.",
     "big": false
    },
    {
     "t0": 7.87,
     "t1": 8.41,
     "text": "Tres.",
     "big": false
    },
    {
     "t0": 8.43,
     "t1": 12.93,
     "text": "Y nadie más.",
     "big": false
    },
    {
     "t0": 15.61,
     "t1": 20.11,
     "text": "Antes siete corríamos por la costa.",
     "big": false
    },
    {
     "t0": 20.16,
     "t1": 22.69,
     "text": "Ahora tres mirábamos el mar.",
     "big": false
    },
    {
     "t0": 22.71,
     "t1": 25.57,
     "text": "Cuatro lugares vacíos junto al fuego.",
     "big": false
    },
    {
     "t0": 25.59,
     "t1": 28.16,
     "text": "Cuatro voces que vamos a recordar.",
     "big": false
    },
    {
     "t0": 28.18,
     "t1": 30.79,
     "text": "Mañana llegará otro barco.",
     "big": false
    },
    {
     "t0": 30.81,
     "t1": 33.26,
     "text": "Y lo vamos a saquear.",
     "big": false
    },
    {
     "t0": 33.28,
     "t1": 36.54,
     "text": "Nuestros cuatro idiotas se enojarían",
     "big": false
    },
    {
     "t0": 36.56,
     "t1": 39.89,
     "text": "si dejamos el oro atrás.",
     "big": false
    },
    {
     "t0": 39.91,
     "t1": 41.24,
     "text": "Fuimos siete.",
     "big": false
    },
    {
     "t0": 41.26,
     "t1": 42.84,
     "text": "Seguimos siete.",
     "big": false
    },
    {
     "t0": 42.86,
     "t1": 44.91,
     "text": "Con nuestro jefe...",
     "big": false
    },
    {
     "t0": 44.93,
     "t1": 49.43,
     "text": "siempre seremos ocho.",
     "big": false
    },
    {
     "t0": 51.72,
     "t1": 53.15,
     "text": "Mr. Iguana...",
     "big": false
    }
   ],
