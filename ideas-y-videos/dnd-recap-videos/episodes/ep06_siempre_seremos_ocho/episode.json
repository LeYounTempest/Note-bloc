   "lines": [
    {
     "t0": 0,
     "t1": 0.99,
     "text": "Después...",
     "big": false
    },
    {
     "t0": 1.01,
     "t1": 3.7,
     "text": "solo quedaron las olas.",
     "big": false
    },
    {
     "t0": 3.72,
     "t1": 6.34,
     "text": "Nuestro jefe nos comenzó a contar.",
     "big": false
    },
    {
     "t0": 6.36,
     "t1": 7.13,
     "text": "Uno.",
     "big": false
    },
    {
     "t0": 7.15,
     "t1": 7.85,
     "text": "Dos.",
     "big": false
    },
    {
     "t0": 7.87,
     "t1": 8.41,
     "text": "Tres.",
     "big": false
    },
    {
     "t0": 8.43,
     "t1": 12.93,
     "text": "Y nadie más.",
     "big": false
    },
    {
     "t0": 15.61,
     "t1": 20.11,
     "text": "Antes siete corríamos por la costa.",
     "big": false
    },
    {
     "t0": 20.16,
     "t1": 22.69,
     "text": "Ahora tres mirábamos el mar.",
     "big": false
    },
    {
     "t0": 22.71,
     "t1": 25.57,
     "text": "Cuatro lugares vacíos junto al fuego.",
     "big": false
    },
    {
     "t0": 25.59,
     "t1": 28.2,
     "text": "Cuatro voces que vamos a recordar.",
     "big": false
    },
    {
     "t0": 28.22,
     "t1": 30.19,
     "text": "Somos hijos de la costa.",
     "big": false
    },
    {
     "t0": 30.21,
     "t1": 33.23,
     "text": "Cuatro no regresarán.",
     "big": false
    },
    {
     "t0": 33.25,
     "t1": 34.58,
     "text": "No tenemos reino.",
     "big": false
    },
    {
     "t0": 34.6,
     "t1": 36.26,
     "text": "Nunca tuvimos oro.",
     "big": false
    },
    {
     "t0": 36.28,
     "t1": 38.89,
     "text": "Solo este viejo hogar.",
     "big": false
    },
    {
     "t0": 38.91,
     "t1": 42.56,
     "text": "Pero mientras nuestro jefe siga en pie...",
     "big": false
    },
    {
     "t0": 42.58,
     "t1": 47.08,
     "text": "¡nosotros vamos a continuar!",
     "big": false
    },
    {
     "t0": 51.28,
     "t1": 53.89,
     "text": "Mañana llegará otro barco.",
     "big": false
    },
    {
     "t0": 53.91,
     "t1": 56.36,
     "text": "Y lo vamos a saquear.",
     "big": false
    },
    {
     "t0": 56.38,
     "t1": 59.63,
     "text": "Nuestros cuatro idiotas se enojarían",
     "big": false
    },
    {
     "t0": 59.65,
     "t1": 62.99,
     "text": "si dejamos el oro atrás.",
     "big": false
    },
    {
     "t0": 63.01,
     "t1": 64.34,
     "text": "Fuimos siete.",
     "big": false
    },
    {
     "t0": 64.36,
     "t1": 65.94,
     "text": "Seguimos siete.",
     "big": false
    },
    {
     "t0": 65.96,
     "t1": 68.01,
     "text": "Con nuestro jefe...",
     "big": false
    },
    {
     "t0": 68.03,
     "t1": 72.53,
     "text": "siempre seremos ocho.",
     "big": false
    },
    {
     "t0": 74.81,
     "t1": 76.25,
     "text": "Mr. Iguana...",
     "big": false
    }
